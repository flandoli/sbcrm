# ───── Funil Comercial (sbcrm) — variáveis de ambiente v1 ─────

# Plataforma / auth (DATABASE_URL e NEXTAUTH_SECRET são provisionados pela Abacus.AI no app novo)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sbcrm?schema=public"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://sbcrm.abacusai.app"
APP_HOSTNAME="sbcrm"
ABACUSAI_API_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
TZ="America/Sao_Paulo"

# Criptografia de segredos em repouso (chaves OpenAI dos usuários).
# 32 bytes em base64: openssl rand -base64 32  — NUNCA versionar o valor real.
ENCRYPTION_KEY=""

# Seed do usuário Admin (usado apenas por `yarn seed` / `prisma db seed`)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

# Integração ChatGPT: a API Key é por usuário (painel Configurações → IA) e fica no banco criptografada.
# Estas variáveis são apenas padrões do servidor.
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-4o-mini"

# Meta Conversions API (modo "posterior" de qualificação) — código mantido, DESLIGADO na v1
# (Setting capi_enabled=false). Preencher só quando for ligado.
META_CAPI_TOKEN=""
META_PIXEL_ID=""

